# Copy to the LIVE server only (never commit the real file):
#   ~/backups/jagdamba/backup.env
#
# chmod 600 ~/backups/jagdamba/backup.env

# Laravel app root on Hostinger
BACKUP_APP_DIR=/home/YOUR_USER/domains/digitalcreatorss.com/jagdamba

# rclone destination (remote name from: rclone config)
# Example after configuring Google Drive as remote "gdrive":
RCLONE_REMOTE=gdrive:jagdamba-jwellers-backups

# Local copies kept on the server (days)
RETENTION_DAYS=14

# Optional: alert email if backup fails (requires mail on server)
# BACKUP_ALERT_EMAIL=owner@example.com
